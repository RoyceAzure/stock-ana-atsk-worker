GITHUB_USER=your-github-username
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
K8S_RELEASE_NAME=dev
K8S_NAMESPACE=sexy-stock
PG_LOCAL_PORT=5432

# Worker / main 入口（python main.py --mode consumer；CLI 優先於此 env）
WORKER_MODE=consumer
LOG_LEVEL=info

# Worker / PostgreSQL（worker 與 make k8s-deploy-local 共用；有值時 Helm 優先於 chart values.yaml）
PG_HOST=localhost
PG_DATABASE=sexy_stock
PG_USER=postgres
PG_PASSWORD=
PG_PORT=5432

# Worker / 雲端廠商（目前僅支援 gcp）
CLOUD_PROVIDER=gcp

# Worker / 任務類型（逗號分隔 event_name；預設 preprocessing）
WORKER_TASK_TYPES=preprocessing

# Worker / GCP 憑證（Pub/Sub、gcsfs merger 共用）
# adc = GKE Workload Identity / 本機 gcloud ADC
# service_account_json = SA JSON 金鑰檔（kind / 本機 K8s）
GCP_AUTH_MODE=adc
# GCP_PUBSUB_AUTH_MODE=adc
# GCP_SA_KEY_FILE=/var/secrets/google/key.json
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# Worker / GCP Pub/Sub
GCP_PROJECT_ID=
GCP_TASK_SUBSCRIPTION_ID=

# Worker / 物件儲存與 DuckDB
STORAGE_BACKEND=gcs
OBJECT_STORAGE_BUCKET_BASE_PATH=your-bucket/your-prefix
DUCKDB_POOL_SIZE=10
PUBSUB_BATCH_SIZE=10
PUBSUB_VISIBILITY_TIMEOUT=30
PUBSUB_PULL_TIMEOUT=5.0

# DuckDB GCS 整合測試（tests/integration/repo/duckdb/conftest.py）
# GCS_TEST_BUCKET=your-test-bucket
# GCS_TEST_PREFIX=test/duckdb
