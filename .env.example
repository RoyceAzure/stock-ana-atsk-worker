GITHUB_USER=your-github-username
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
K8S_RELEASE_NAME=dev
K8S_NAMESPACE=sexy-stock
# 本機 port-forward 用（Windows Hyper-V 常保留 5378-5477，5432 會 bind 失敗，請用 15432）
PG_LOCAL_PORT=15432

# Worker / main 入口（python main.py --mode consumer；CLI 優先於此 env）
WORKER_MODE=consumer
LOG_LEVEL=info

# Worker / PostgreSQL（worker 與 make k8s-deploy-local 共用；有值時 Helm 優先於 chart values.yaml）
PG_HOST=localhost
PG_DATABASE=sexy_stock
PG_USER=postgres
PG_PASSWORD=
PG_PORT=5432

# Worker / 雲端廠商（目前僅支援 gcp）
CLOUD_PROVIDER=gcp

# Worker / 任務類型（逗號分隔 event_name；預設 preprocessing）
WORKER_TASK_TYPES=preprocessing

# Worker / GCP Pub/Sub
GCP_PROJECT_ID=
GCP_TASK_SUBSCRIPTION_ID=

# kind Helm 部署時建議 service_account_json（GKE 正式環境用 adc + Workload Identity）
GCP_AUTH_MODE=service_account_json

# Worker / 物件儲存與 DuckDB
STORAGE_BACKEND=gcs
OBJECT_STORAGE_BUCKET_BASE_PATH=your-bucket/your-prefix

# Worker / GCP 憑證（Pub/Sub、gcsfs merger 共用）
# 本機 python main.py：adc + gcloud auth application-default login
# kind Helm：service_account_json + deployment/secrets/gcp-sa.json（見 deployment/secrets/README.md）
# GCP_SA_KEY_FILE=deployment/secrets/gcp-sa.json
# GCP_SA_SECRET_NAME=gcp-sa-key
DUCKDB_POOL_SIZE=10
PUBSUB_BATCH_SIZE=10
PUBSUB_VISIBILITY_TIMEOUT=30
PUBSUB_PULL_TIMEOUT=5.0

# DuckDB GCS 整合測試（tests/integration/repo/duckdb/conftest.py）
# GCS_TEST_BUCKET=your-test-bucket
# GCS_TEST_PREFIX=test/duckdb

# Promtail / Loki（helm-install-promtail / helm-install-logging）
# LOKI_PUSH_URL=http://loki.sexy-stock.svc.cluster.local:3100/loki/api/v1/push

# Grafana（helm-install-grafana）
# GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_LOCAL_PORT=3000
