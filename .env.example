GITHUB_USER=your-github-username
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
K8S_RELEASE_NAME=dev
K8S_NAMESPACE=sexy-stock
PG_LOCAL_PORT=5432

# 物件儲存（S3 / MinIO / GCS）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SECURE=true

# GCS：在 GCP 上建議 GCS_USE_ADC=true（僅 fsspec/gcsfs）；DuckDB 需 HMAC key
GCS_USE_ADC=false
GCS_HMAC_ACCESS_KEY=
GCS_HMAC_SECRET_KEY=

# DuckDB GCS 整合測試（tests/integration/repo/duckdb/conftest.py）
# GCS_TEST_BUCKET=your-test-bucket
# GCS_TEST_PREFIX=test/duckdb
