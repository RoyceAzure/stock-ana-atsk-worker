GITHUB_USER=your-github-username
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
K8S_RELEASE_NAME=dev
K8S_NAMESPACE=sexy-stock
PG_LOCAL_PORT=5432

# Worker / main 入口（python main.py --mode consumer；CLI 優先於此 env）
WORKER_MODE=consumer

# Worker / PostgreSQL
PG_HOST=localhost
PG_DATABASE=sexy_stock
PG_USER=postgres
PG_PASSWORD=
PG_PORT=5432

# Worker / 雲端廠商（目前僅支援 gcp；aws 為後續擴充）
CLOUD_PROVIDER=gcp

# Worker / 任務類型（逗號分隔 event_name；預設 preprocessing）
WORKER_TASK_TYPES=preprocessing

# Worker / GCP Pub/Sub
GCP_PROJECT_ID=
GCP_SUBSCRIPTION_ID=

# Worker / 物件儲存與 DuckDB（CLOUD_PROVIDER=gcp 時須為 gcs）
STORAGE_BACKEND=gcs
OBJECT_STORAGE_BUCKET_BASE_PATH=your-bucket/your-prefix
DUCKDB_POOL_SIZE=10
PUBSUB_BATCH_SIZE=10
PUBSUB_VISIBILITY_TIMEOUT=30
PUBSUB_PULL_TIMEOUT=5.0

# 物件儲存（S3 / MinIO / GCS）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SECURE=true

# GCS：在 GCP 上建議 GCS_USE_ADC=true（僅 fsspec/gcsfs）；DuckDB 需 HMAC key
GCS_USE_ADC=false
GCS_HMAC_ACCESS_KEY=
GCS_HMAC_SECRET_KEY=

# DuckDB GCS 整合測試（tests/integration/repo/duckdb/conftest.py）
# GCS_TEST_BUCKET=your-test-bucket
# GCS_TEST_PREFIX=test/duckdb
