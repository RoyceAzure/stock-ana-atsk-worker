        "label": "Pod",
        "multi": true,
        "name": "pod",
        "query": { "query": "label_values(kube_pod_info{namespace=\"$namespace\", pod=~\"{{ include "grafana.workerPodRegex" . }}\"}, pod)", "refId": "PrometheusVariableQuery" },
