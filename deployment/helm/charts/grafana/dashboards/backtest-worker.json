      "targets": [
        {
          "expr": "kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\", pod=~\"$pod\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "kube_pod_info{namespace=\"$namespace\", pod=~\"$pod\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "title": "Pod Status (OOM / Node)",
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "pod" } }
      ],
      "type": "table"
    }
