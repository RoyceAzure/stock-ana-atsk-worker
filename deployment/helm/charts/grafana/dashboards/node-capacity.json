{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "各節點目前容量與使用量（絕對值，非百分比）。用於評估 GCP 機器規格。",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "decimals": 2,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Node" },
            "properties": [{ "id": "custom.width", "value": 220 }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/CPU.*/" },
            "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 2 }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/Mem.*/" },
            "properties": [{ "id": "unit", "value": "bytes" }, { "id": "decimals", "value": 2 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "CPU Used (cores)" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count by (node) (node_cpu_seconds_total{mode=\"idle\", node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "cpu_total"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (rate(node_cpu_seconds_total{mode!=\"idle\", node=~\"$node\"}[5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "cpu_used"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max_over_time(sum by (node) (rate(node_cpu_seconds_total{mode!=\"idle\", node=~\"$node\"}[5m]))[$__range:])",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "cpu_max"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "mem_total"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{node=~\"$node\"} - node_memory_MemAvailable_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "mem_used"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max_over_time((node_memory_MemTotal_bytes{node=~\"$node\"} - node_memory_MemAvailable_bytes{node=~\"$node\"})[$__range:])",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "mem_max"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemAvailable_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "mem_avail"
        }
      ],
      "title": "Node capacity summary (absolute values)",
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "node" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true, "Time 6": true, "Time 7": true },
            "indexByName": {
              "node": 0,
              "Value #cpu_total": 1,
              "Value #cpu_used": 2,
              "Value #cpu_max": 3,
              "Value #mem_total": 4,
              "Value #mem_used": 5,
              "Value #mem_max": 6,
              "Value #mem_avail": 7
            },
            "renameByName": {
              "Value #cpu_max": "CPU Max (cores)",
              "Value #cpu_total": "CPU Total (cores)",
              "Value #cpu_used": "CPU Used (cores)",
              "Value #mem_avail": "Mem Available",
              "Value #mem_max": "Mem Used Max",
              "Value #mem_total": "Mem Total",
              "Value #mem_used": "Mem Used",
              "node": "Node"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "decimals": 2,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/ total$/" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (rate(node_cpu_seconds_total{mode!=\"idle\", node=~\"$node\"}[5m]))",
          "legendFormat": "{{ "{{" }}node{{ "}}" }} used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count by (node) (node_cpu_seconds_total{mode=\"idle\", node=~\"$node\"})",
          "legendFormat": "{{ "{{" }}node{{ "}}" }} total",
          "refId": "B"
        }
      ],
      "title": "Node CPU (cores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "decimals": 2,
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/ total$/" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{node=~\"$node\"} - node_memory_MemAvailable_bytes{node=~\"$node\"}",
          "legendFormat": "{{ "{{" }}node{{ "}}" }} used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{node=~\"$node\"}",
          "legendFormat": "{{ "{{" }}node{{ "}}" }} total",
          "refId": "B"
        }
      ],
      "title": "Node Memory (bytes)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "decimals": 2,
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "min"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemAvailable_bytes{node=~\"$node\"}",
          "legendFormat": "{{ "{{" }}node{{ "}}" }}",
          "refId": "A"
        }
      ],
      "title": "Node Memory Available (bytes)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "decimals": 2,
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (rate(node_network_receive_bytes_total{node=~\"$node\", device!~\"lo|veth.*|docker.*|cilium.*|flannel.*\"}[5m]))",
          "legendFormat": "{{ "{{" }}node{{ "}}" }} rx",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (node) (rate(node_network_transmit_bytes_total{node=~\"$node\", device!~\"lo|veth.*|docker.*|cilium.*|flannel.*\"}[5m]))",
          "legendFormat": "{{ "{{" }}node{{ "}}" }} tx",
          "refId": "B"
        }
      ],
      "title": "Node Network (bytes/s)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["kubernetes", "prometheus", "node", "capacity"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(node_uname_info, node)",
        "hide": 0,
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "options": [],
        "query": {
          "query": "label_values(node_uname_info, node)",
          "refId": "PrometheusVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
