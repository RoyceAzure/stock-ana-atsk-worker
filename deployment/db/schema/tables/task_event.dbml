// Table: task_event
// Migrations: 000006, 000008, 000011, 000015, 000023, 000026

Table task_event {
  id uuid [pk, not null, note: 'UUID generated by backend']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  status task_status [not null, default: 'pending']
  tester_name varchar(100)
  tester_params jsonb
  data_provider_name varchar(100)
  source_meta_data jsonb [note: 'JSON，常用欄位：code、candle（見 expression index）']
  tpsl_name varchar(100)
  tpsl_params jsonb
  saver_params jsonb
  trigger_type trigger_type [not null]
  triggered_by varchar(100) [not null, note: 'User ID or system ID who triggered the task']
  schedule_id varchar(100) [note: 'Reference to schedule if triggered by scheduler']
  schedule_name varchar(200)
  start_time timestamp
  end_time timestamp
  error_message text
  event_name varchar(100) [not null, default: 'none']
  event_stage varchar(100) [not null, default: 'none']
  used_process_pool boolean [not null, default: false]
  is_notify boolean [not null, default: false]

  indexes {
    status [name: 'idx_task_event_status']
    tester_name [name: 'idx_task_event_tester_name']
    created_at [name: 'idx_task_event_created_at']
    trigger_type [name: 'idx_task_event_trigger_type']
    triggered_by [name: 'idx_task_event_triggered_by']
    start_time [name: 'idx_task_event_start_time']
    end_time [name: 'idx_task_event_end_time']
    (source_meta_data, tester_name, event_name) [name: 'idx_task_event_main', note: 'PG expression: (source_meta_data->>''code''), tester_name, event_name']
    source_meta_data [name: 'idx_task_event_candle', note: 'PG expression: (source_meta_data->>''candle'')']
  }

  Note: '回測／任務執行事件主表。'
}
