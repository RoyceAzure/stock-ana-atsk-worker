# 複製為 script/.env 後填入實際值：
#   cp script/.env.example script/.env
# Windows: make db-backup / make db-restore（PowerShell + script/*.ps1）
# Linux/WSL: 同上 make 目標會改走 script/*.sh

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-password
PG_DB=sexy_stock

# 物件儲存（備份路徑：s3://{S3_BUCKET}/{PROJECT_NAME}/{APP_ENV}/db-backup/{TARGET_TABLE}/）
S3_BUCKET=your-bucket
PROJECT_NAME=sexy-stock
APP_ENV=dev
TARGET_TABLE=task_event

# AWS S3 憑證（若使用 GCS，可改填下方 GCS HMAC，或由 load-env.sh 自動對應）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# GCS S3 互通（與 worker .env 相同 HMAC 即可；有設時會覆蓋未填的 AWS_*）
GCS_HMAC_ACCESS_KEY=
GCS_HMAC_SECRET_KEY=

# 非 AWS S3 時必填 endpoint（GCS 範例）
S3_ENDPOINT=https://storage.googleapis.com
